#!/bin/bash
#SBATCH --job-name=nightly_analysis
#SBATCH --time=02:00:00
#SBATCH --account=tra26_bbs
#SBATCH --partition=boost_usr_prod
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --error nightly_analysis-%j.err
#SBATCH --output nightly_analysis-%j.out

# Activate the shared environment
source /leonardo_scratch/fast/tra26_bbs/intro_to_llms_venv/bin/activate

# The model server endpoint is passed in via environment variable
ENDPOINT="http://lrdn2874:8000/v1"
echo "Using endpoint: $ENDPOINT"

# Run the pipeline
python ../../hugo/student_job_LLM.py --endpoint "$ENDPOINT" --n 50 --output ../../hugo/nightly_results.csv